# ============================================================================
# ChipForge environment variables (example)
# Copy to `.env` and fill in real values for local development.
# ============================================================================

# --- API / Database ---
DATABASE_URL=postgresql+asyncpg://chipforge:chipforge@localhost:5432/chipforge
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally, S3 in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=chipforge

# --- Auth ---
JWT_SECRET=dev-only-change-me
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# --- AI providers (all optional; falls back to MockProvider if unset) ---
AI_PROVIDER=mock                # mock | openai | anthropic | vllm | ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
VLLM_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434

# --- Web (Next.js public envs) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ChipForge
